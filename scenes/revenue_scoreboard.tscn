[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/revenue_scoreboard.gd" id="1_scoreboard"]

[sub_resource type="StyleBoxFlat" id="StylePanel"]
bg_color = Color(0.05, 0.067, 0.106, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.16, 0.21, 0.29, 1)

[node name="Scoreboard" type="PanelContainer"]
theme_override_styles/panel = SubResource("StylePanel")
script = ExtResource("1_scoreboard")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 12

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.29, 0.94, 0.82, 1)
theme_override_font_sizes/font_size = 13
text = "LIVE REVENUE"
horizontal_alignment = 1

[node name="RevenueLabel" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.94, 0.96, 1, 1)
theme_override_font_sizes/font_size = 24
text = "$0"
horizontal_alignment = 1

[node name="TargetLabel" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.98, 0.72, 0.25, 1)
theme_override_font_sizes/font_size = 13
text = "GOAL  $1000"
horizontal_alignment = 1

[node name="ProgressBar" type="ProgressBar" parent="Margin/Content"]
custom_minimum_size = Vector2(0, 14)
layout_mode = 2
max_value = 100.0
show_percentage = false

[node name="ProgressLabel" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.73, 0.79, 1)
theme_override_font_sizes/font_size = 11
text = "0% OF GOAL"
horizontal_alignment = 1

[node name="FeedbackLabel" type="Label" parent="Margin/Content"]
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
theme_override_colors/font_color = Color(0.98, 0.72, 0.25, 1)
theme_override_font_sizes/font_size = 12
text = "$1000 TO GO"
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

[node name="Spacer" type="Control" parent="Margin/Content"]
layout_mode = 2
size_flags_vertical = 3

[node name="PauseButton" type="Button" parent="Margin/Content"]
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
disabled = true
text = "Pause"

[node name="EndWorkdayButton" type="Button" parent="Margin/Content"]
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
disabled = true
text = "END WORKDAY"
